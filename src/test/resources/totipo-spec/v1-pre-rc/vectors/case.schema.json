  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "dispatch"
          }
        }
      },
      "then": {
        "required": [
          "semantic_hex",
          "root_hex",
          "crypto"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "crypto"
          }
        }
      },
      "then": {
        "required": [
          "semantic_hex",
          "root_hex",
          "crypto"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
