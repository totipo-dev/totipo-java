        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observations",
            "learned_ids",
            "opaque_unscoped_ids",
            "authoritative",
            "view"
          ],
          "properties": {
            "observations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "class"
