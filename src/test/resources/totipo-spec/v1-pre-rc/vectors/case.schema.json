                "candidate_warning": {
                  "type": "boolean"
                },
                "integrity_failure": {
                  "type": "boolean"
                },
                "presentation": {
                  "enum": [
                    "UNAVAILABLE",
                    "OPAQUE",
                    "VERIFIED",
                    "CONFLICT"
                  ]
                }
