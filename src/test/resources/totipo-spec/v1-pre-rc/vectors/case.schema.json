                },
                "then": {
                  "required": [
                    "node"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "action": {
                      "const": "query"
                    }
                  }
                },
                "then": {
                  "required": [
                    "query",
                    "expect"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "action": {
                      "const": "disappear"
                    }
                  }
                },
                "then": {
                  "required": [
                    "id"
                  ]
                }
              }
            ]
          },
          "minItems": 1
        }
