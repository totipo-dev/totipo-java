                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "class": {
                    "enum": [
                      "SUPPORTED_VALID",
                      "OPAQUE_ROUTABLE",
                      "OPAQUE_UNSCOPED",
                      "INVALID",
                      "INVALID_STORAGE"
                    ]
                  }
                }
              }
            },
            "learned_ids": {
              "type": "array",
