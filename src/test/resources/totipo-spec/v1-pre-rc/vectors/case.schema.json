                  "account": {
                    "type": "string"
                  },
                  "algorithm": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "digits": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "period": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
